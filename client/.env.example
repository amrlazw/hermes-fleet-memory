# ==============================================================================
# hermes-fleet-memory Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HARDWARE-ENFORCED DOMAIN FIREWALL
# Options:
#   - "work"     : Restricts queries to work + shared. Prevents personal data leakage.
#   - "personal" : Restricts queries to personal + shared. Protects gaming/crypto notes.
#   - "shared"   : Default domain for universal documentation, cheatsheets, and tools.
#   - "all"      : Sovereign hub mode (typically for your private Telegram bot on VPS).
# ------------------------------------------------------------------------------
FLEET_HARD_DOMAIN=work

# ------------------------------------------------------------------------------
# 2. VECTOR ENGINE ENDPOINT
# Choose ONE of the following configurations depending on your deployment model:
# ------------------------------------------------------------------------------

# --- OPTION A: Self-Hosted VPS (via WSTunnel or direct TLS) ---
# FLEET_QDRANT_HOST=127.0.0.1
# FLEET_QDRANT_PORT=6333
# FLEET_QDRANT_KEY=your_generated_256bit_cluster_secret
# FLEET_QDRANT_HTTPS=false

# --- OPTION B: Qdrant Cloud (Official 1GB Free Tier - No VPS needed) ---
# FLEET_QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
# FLEET_QDRANT_KEY=your_qdrant_cloud_api_key_here
# FLEET_QDRANT_HTTPS=true

# ------------------------------------------------------------------------------
# 3. OPTION C: FLEET MESH & REMOTE EXECUTION BRIDGE (Optional)
# Allows remote nodes (e.g. Telegram) to run safe shell commands and read files.
# ------------------------------------------------------------------------------
FLEET_BRIDGE_PORT=8099
FLEET_NODE_NAME="Workstation"
# FLEET_ALLOWED_ROOT=/home/username or C:/Users/username
