# Fleet Control Plane - example configuration
# Copy to $FLEET_HOME/.env  (default: ~/.fleet/.env)  and chmod 600.
# `python setup_fleet.py --init` writes this for you and fills in secrets.

# ---------------------------------------------------------------- identity
FLEET_NODE_ID=local
FLEET_NODES=local
FLEET_KEY_ID=local-fleet-1

# ------------------------------------------------------------------ bind
# Loopback by default. Only expose on 0.0.0.0 behind a TLS reverse proxy.
FLEET_HOST=127.0.0.1
FLEET_PORT=8088
FLEET_MAX_PENDING=1000

# ------------------------------------------------------------- node tokens
# One entry per node in FLEET_NODES. These are bearer tokens presented by
# callers; rotate with `setup_fleet.py --init --force`.
FLEET_KEY_LOCAL=replace-with-a-long-random-token

# --------------------------------------------------- telegram (all optional)
# Leave BOTH blank to run without Telegram: notification tasks complete as
# 'skipped' instead of retrying into a dead-letter pile.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
